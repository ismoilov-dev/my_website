# Environment Mode: local / production
ENVIRONMENT=production
DEBUG=False

# Security Settings
# Generate a secret key for production (e.g. python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION

# Host Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,*.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com

# Database Configuration
# Leave every option below commented out to use SQLite (db.sqlite3), which is
# the default for local development.
#
# For PostgreSQL, create the database and role first, then set EITHER
# DATABASE_URL or the POSTGRES_* group (DATABASE_URL wins if both are set).
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/blog_db
# POSTGRES_DB=blog_db
# POSTGRES_USER=your_pg_user
# POSTGRES_PASSWORD=your_real_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Internationalization
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Tashkent

# Security Headers (Production Defaults)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
